# Site
NEXT_PUBLIC_SITE_URL=https://loupitakass.com

# Database (Vercel Postgres = Neon sotto il cofano)
# Free Hobby: più che sufficiente per ~100 record / 3–4 tabelle
DATABASE_URL=
# Alias da integrazione Vercel / `vercel env pull`:
# POSTGRES_URL=
# DB_DATABASE_URL=
# DB_POSTGRES_URL=

# Admin auth (sessione cookie firmata — 1/2 utenti)
AUTH_SECRET=
# Demo seed (password: giocoso): admin@loupitakass.com
ADMIN_EMAIL=
# Genera AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Password hash bcrypt (non in chiaro): npm run auth:hash-password -- "tua-password"
ADMIN_PASSWORD_HASH=

# Upstash Redis (rate limit login + form contatti)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alias da integrazione Vercel Marketplace (opzionale):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=noreply@loupitakass.com

# Vercel Blob (upload volantini / media admin)
# Preferito (store collegato al progetto): BLOB_STORE_ID + VERCEL_OIDC_TOKEN (via `vercel env pull`)
BLOB_STORE_ID=
# Fallback statico (opzionale):
BLOB_READ_WRITE_TOKEN=

# Map (opzionale — MapLibre/OSM gratis di default)
# NEXT_PUBLIC_MAP_STYLE_URL=

# Meta Graph API — feed Facebook + Instagram (System User / Page token)
# Token da Business Manager → Utente di sistema (non scade se generato così)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_PAGE_ID=your_facebook_page_id_here
META_IG_USER_ID=your_instagram_user_id_here
